+
+const played = [
+  { id: 'old-high', playCount: 8, lastPlayedAt: 400, sourceDateAt: 100 },
+  { id: 'tie-newer-listen', playCount: 8, lastPlayedAt: 800, sourceDateAt: 200 },
+  { id: 'low', playCount: 2, lastPlayedAt: 300, sourceDateAt: 900 },
