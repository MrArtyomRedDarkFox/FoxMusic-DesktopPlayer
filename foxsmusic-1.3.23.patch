diff --git a/mobile/src/core.js b/mobile/src/core.js
new file mode 100644
index 0000000..1b618b7
--- /dev/null
+++ b/mobile/src/core.js
@@ -0,0 +1,50 @@
+'use strict';
+
+const SUPPORTED_AUDIO_EXTENSIONS = new Set([
+  'mp3', 'm4a', 'aac', 'wav', 'flac', 'ogg', 'oga', 'opus'
+]);
+
+function getExtension(fileName) {
+  const name = String(fileName || '').trim();
+  const match = name.match(/\.([a-z0-9]{1,8})$/i);
+  return match ? match[1].toLowerCase() : '';
+}
+
+function isSupportedAudio(fileName) {
+  return SUPPORTED_AUDIO_EXTENSIONS.has(getExtension(fileName));
+}
+
+function parseTrackName(fileName) {
+  const cleanName = String(fileName || 'Untitled track').trim();
+  const withoutExtension = cleanName.replace(/\.[^.]+$/, '').trim() || 'Untitled track';
+  const parts = withoutExtension.split(/\s+-\s+/);
+
+  if (parts.length >= 2) {
+    return {
+      artist: parts.shift().trim(),
+      title: parts.join(' - ').trim() || withoutExtension
+    };
+  }
+
+  return { artist: '', title: withoutExtension };
+}
+
+function formatTime(value) {
+  const seconds = Number.isFinite(Number(value)) ? Math.max(0, Math.floor(Number(value))) : 0;
+  const minutes = Math.floor(seconds / 60);
+  const remainder = seconds % 60;
+  return `${minutes}:${String(remainder).padStart(2, '0')}`;
+}
+
+function createId(now = Date.now(), random = Math.random()) {
+  return `${now.toString(36)}-${random.toString(36).slice(2, 10)}`;
+}
+
+module.exports = {
+  SUPPORTED_AUDIO_EXTENSIONS,
+  getExtension,
+  isSupportedAudio,
+  parseTrackName,
+  formatTime,
+  createId
+};
diff --git a/mobile/tests/config.test.cjs b/mobile/tests/config.test.cjs
new file mode 100644
index 0000000..2a4c232
--- /dev/null
+++ b/mobile/tests/config.test.cjs
@@ -0,0 +1,57 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const root = path.resolve(__dirname, '..');
+const appConfig = JSON.parse(fs.readFileSync(path.join(root, 'app.json'), 'utf8')).expo;
+const packageConfig = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8'));
+
+function findPlugin(name) {
+  return appConfig.plugins.find(plugin =>
+    plugin === name || (Array.isArray(plugin) && plugin[0] === name)
+  );
+}
+
+test('mobile project has a distinct Android application identity', () => {
+  assert.equal(packageConfig.name, 'foxsmusic-mobile');
+  assert.equal(appConfig.slug, 'foxsmusic-android');
+  assert.equal(appConfig.android.package, 'com.artyomreddarkfox.foxsmusic.mobile');
+  assert.notEqual(appConfig.android.package, 'com.artyomreddarkfox.foxsmusic');
+});
+
+test('background playback is enabled without microphone recording permission', () => {
+  const audioPlugin = findPlugin('expo-audio');
+  assert.ok(audioPlugin, 'expo-audio config plugin should be present');
+  assert.equal(audioPlugin[1].enableBackgroundPlayback, true);
+  assert.equal(audioPlugin[1].enableBackgroundRecording, false);
+  assert.equal(audioPlugin[1].recordAudioAndroid, false);
+  assert.ok(appConfig.android.permissions.includes('POST_NOTIFICATIONS'));
+});
+
+test('splash screen uses the SDK-supported config plugin', () => {
+  assert.equal(Object.hasOwn(appConfig, 'splash'), false, 'legacy top-level splash config should be removed');
+  const splashPlugin = findPlugin('expo-splash-screen');
+  assert.ok(Array.isArray(splashPlugin), 'expo-splash-screen config plugin should be configured');
+  assert.equal(splashPlugin[1].image, './assets/splash.png');
+  assert.equal(splashPlugin[1].backgroundColor, '#08070a');
+});
+
+test('Android icon and splash assets exist', () => {
+  const splashPlugin = findPlugin('expo-splash-screen');
+  for (const relativePath of [
+    appConfig.icon,
+    splashPlugin[1].image,
+    appConfig.android.adaptiveIcon.foregroundImage,
+  ]) {
+    assert.ok(fs.existsSync(path.join(root, relativePath)), 'asset should exist: ' + relativePath);
+  }
+});
+
+test('preview EAS profile creates an installable APK', () => {
+  const eas = JSON.parse(fs.readFileSync(path.join(root, 'eas.json'), 'utf8'));
+  assert.equal(eas.build.preview.distribution, 'internal');
+  assert.equal(eas.build.preview.android.buildType, 'apk');
+});
diff --git a/mobile/tests/core.test.cjs b/mobile/tests/core.test.cjs
new file mode 100644
index 0000000..e4f4d53
--- /dev/null
+++ b/mobile/tests/core.test.cjs
@@ -0,0 +1,61 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+  getExtension,
+  isSupportedAudio,
+  parseTrackName,
+  formatTime,
+  createId
+} = require('../src/core');
+
+test('accepts common Android audio extensions case-insensitively', () => {
+  for (const file of ['song.mp3', 'song.M4A', 'song.aac', 'song.wav', 'song.flac', 'song.ogg', 'song.oga', 'song.opus']) {
+    assert.equal(isSupportedAudio(file), true, `${file} should be accepted`);
+  }
+  assert.equal(isSupportedAudio('cover.jpg'), false);
+  assert.equal(isSupportedAudio('archive.zip'), false);
+  assert.equal(isSupportedAudio('track'), false);
+});
+
+test('extracts an extension safely', () => {
+  assert.equal(getExtension('  Artist - Song.MP3  '), 'mp3');
+  assert.equal(getExtension('song'), '');
+  assert.equal(getExtension('song.'), '');
+});
+
+test('parses the Desktop-style Artist - Title filename convention', () => {
+  assert.deepEqual(parseTrackName('Queen - Bohemian Rhapsody.mp3'), {
+    artist: 'Queen',
+    title: 'Bohemian Rhapsody'
+  });
+  assert.deepEqual(parseTrackName('Artist - Part One - Part Two.flac'), {
+    artist: 'Artist',
+    title: 'Part One - Part Two'
+  });
+});
+
+test('keeps filenames without artist metadata intact', () => {
+  assert.deepEqual(parseTrackName('Night Drive.m4a'), {
+    artist: '',
+    title: 'Night Drive'
+  });
+  assert.deepEqual(parseTrackName(''), {
+    artist: '',
+    title: 'Untitled track'
+  });
+});
+
+test('formats elapsed time safely', () => {
+  assert.equal(formatTime(0), '0:00');
+  assert.equal(formatTime(83), '1:23');
+  assert.equal(formatTime(3600), '60:00');
+  assert.equal(formatTime(-5), '0:00');
+  assert.equal(formatTime(Number.NaN), '0:00');
+});
+
+test('creates distinct non-empty local identifiers', () => {
+  assert.equal(createId(1000, 0.5), 'rs-i');
+  assert.notEqual(createId(1000, 0.1), createId(1000, 0.2));
+});
